# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored -- never commit it.

# Where the MCP server lives. Leave the two path values blank to make the
# helpers read your VS Code mcp.json instead.
CAMCP_SERVER=ca-mcp-x18

# Python interpreter that has the `mcp` package installed.
# CAMCP_PYTHON=/path/to/venv/bin/python

# Directory holding the `camcp` package:
#   <Chief install>/resources/camcp/src
# CAMCP_CHIEF_SRC=/path/to/Chief Architect Premier/resource/camcp/src

# Optional: point at a different VS Code mcp.json.
# CAMCP_MCP_JSON=/path/to/Code/User/mcp.json

# Optional: load a different env file.
# CAMCP_ENV_FILE=
